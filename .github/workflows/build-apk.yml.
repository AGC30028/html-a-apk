name: Compilar APK

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Descomprimir el proyecto
        run: unzip -q agc-android.zip -d proj

      - name: Compilar
        working-directory: proj/agc-android
        run: gradle assembleDebug --no-daemon --stacktrace

      - name: Guardar APK como artefacto
        uses: actions/upload-artifact@v4
        with:
          name: AGC-APK
          path: proj/agc-android/app/build/outputs/apk/debug/app-debug.apk

      - name: Publicar el APK en Releases
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          cp proj/agc-android/app/build/outputs/apk/debug/app-debug.apk AGC-video-autonomo.apk
          gh release create "apk-${{ github.run_number }}" AGC-video-autonomo.apk --title "AGC video autonomo - compilacion ${{ github.run_number }}" --notes "APK de prueba (debug)."
